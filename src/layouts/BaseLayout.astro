---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { shared } from '../data/shared';
import { getDictionary, locales, pathFor, type Locale, type RouteKey } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  routeKey: RouteKey;
  noindex?: boolean;
  /** False for pages without a URL of their own, such as the 404 page. */
  canonical?: boolean;
}

const { lang, title, description, routeKey, noindex = false, canonical: hasCanonical = true } = Astro.props;
const t = getDictionary(lang);
const site = Astro.site ?? new URL(shared.site.url);
const canonical = new URL(pathFor(routeKey, lang), site);
const shareImage = new URL(`/og/${lang}.png`, site);
const analyticsToken = import.meta.env.PROD ? shared.analytics.cloudflareToken : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hasCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      !noindex &&
        locales.map((locale) => (
          <link rel="alternate" hreflang={locale} href={new URL(pathFor(routeKey, locale), site)} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(pathFor(routeKey, 'en'), site)} />}

    <meta name="theme-color" content="#0a0a0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={shared.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={getDictionary(lang === 'en' ? 'fr' : 'en').ogLocale} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.og.subtitle} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} routeKey={routeKey} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} routeKey={routeKey} />
  </body>
</html>
