---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  images: Array<{ src: ImageMetadata; alt: string }>;
  note: string;
  closeLabel: string;
}

const { id, title, images, note, closeLabel } = Astro.props;
---

<dialog class="proof" id={id} aria-labelledby={`${id}-title`}>
  <div class="proof__panel">
    <div class="proof__head">
      <h3 id={`${id}-title`} class="proof__title">{title}</h3>
      <button type="button" class="proof__close" data-dialog-close aria-label={closeLabel}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div class="proof__images">
      {
        images.map((image) => (
          <Image
            src={image.src}
            alt={image.alt}
            widths={[480, 800, 1100]}
            sizes="(min-width: 60rem) 54rem, 92vw"
            loading="lazy"
          />
        ))
      }
    </div>
    <p class="proof__note">{note}</p>
  </div>
</dialog>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    const opener = target.closest<HTMLElement>('[data-dialog-open]');
    if (opener?.dataset.dialogOpen) {
      const dialog = document.getElementById(opener.dataset.dialogOpen);
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    if (target.closest('[data-dialog-close]')) {
      target.closest('dialog')?.close();
      return;
    }

    // A click on the dialog element itself is a click on the backdrop.
    if (target instanceof HTMLDialogElement) target.close();
  });
</script>

<style>
  .proof {
    width: min(56rem, 100vw - 1.5rem);
    max-height: min(90dvh, 90vh);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
  }

  .proof::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  .proof__panel {
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .proof__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: -1rem -1rem 0;
    padding: 1rem;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
  }

  .proof__title {
    font-size: 1rem;
    font-weight: 700;
  }

  .proof__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .proof__images {
    display: grid;
    gap: 1rem;
  }

  .proof__images img {
    width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }

  .proof__note {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
