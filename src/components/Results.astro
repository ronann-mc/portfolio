---
import LiteYouTube from './LiteYouTube.astro';
import ProofDialog from './ProofDialog.astro';
import { shared } from '../data/shared';
import type { Channel, ProofKind } from '../data/types';
import { fill, getDictionary, highlight, type Locale } from '../i18n';
import { formatCompactPrecise, formatMonthYear, formatNumber, formatPercent } from '../lib/format';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

function proofAlt(channel: Channel, kind: ProofKind): string {
  const views = kind === 'channelViews' ? channel.views : channel.bestShort.views;
  return fill(t.results.proofAlts[kind], {
    channel: channel.name,
    views: formatNumber(views, lang),
    stayed: formatNumber(channel.bestShort.stayedToWatch, lang),
  });
}

const cards = shared.channels.map((channel) => {
  const label = t.results.channelLabels[channel.id];
  if (!label) throw new Error(`Add a label for channel "${channel.id}" in results.channelLabels (${lang}.ts)`);
  const short = channel.bestShort;
  return {
    channel,
    label,
    stats: [
      { value: formatCompactPrecise(short.views, lang), label: t.results.stats.views },
      { value: `+${formatCompactPrecise(short.subscribersGained, lang)}`, label: t.results.stats.subscribersGained },
      { value: formatPercent(short.stayedToWatch, lang), label: t.results.stats.stayedToWatch },
    ],
    channelLine: fill(t.results.channelLine, {
      views: formatCompactPrecise(channel.views, lang),
      subscribers: formatCompactPrecise(channel.subscribers, lang),
      launched: formatMonthYear(channel.launched, lang),
    }),
    proofs: channel.proofs.map((proof) => ({ src: proof.image, alt: proofAlt(channel, proof.kind) })),
  };
});
---

<section id="results" class="section" aria-labelledby="results-title">
  <div class="container">
    <div class="section__head">
      <h2 id="results-title" class="display section-title" set:html={highlight(t.results.title)} />
      <p class="section__intro">{t.results.intro}</p>
    </div>

    <div class="results">
      {
        cards.map(({ channel, label, stats, channelLine, proofs }) => (
          <article class="result card" aria-labelledby={`result-${channel.id}`}>
            <div class="result__player">
              <LiteYouTube
                id={channel.bestShort.youtubeId}
                title={`${channel.name}, ${t.results.bestShort}`}
                playLabel={fill(t.player.play, { title: `${channel.name}, ${t.results.bestShort}` })}
                badge={t.results.bestShort}
              />
            </div>
            <div class="result__info">
              <p class="eyebrow">{label}</p>
              <h3 id={`result-${channel.id}`} class="display result__name">
                {channel.name}
              </h3>
              <dl class="result__stats">
                {stats.map((stat) => (
                  <div>
                    <dt>{stat.label}</dt>
                    <dd>{stat.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <p class="result__channel">{channelLine}</p>
            <div class="result__actions">
              <button type="button" class="btn btn--ghost btn--small" data-dialog-open={`proofs-${channel.id}`}>
                {t.results.seeProofs}
              </button>
              <a class="text-link" href={channel.url} target="_blank" rel="noopener">
                {t.results.visitChannel}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
            <ProofDialog
              id={`proofs-${channel.id}`}
              title={fill(t.results.proofsTitle, { channel: channel.name })}
              images={proofs}
              note={t.results.proofNote}
              closeLabel={t.results.close}
            />
          </article>
        ))
      }
    </div>
    <p class="results__note">{t.player.note}</p>
  </div>
</section>

<style>
  .results {
    display: grid;
    gap: 1.25rem;
  }

  .result {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 1rem 1.25rem;
    padding: 1rem;
  }

  .result__info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .result__name {
    font-size: clamp(1.125rem, 4.5vw, 1.625rem);
    overflow-wrap: anywhere;
  }

  .result__stats {
    display: grid;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
  }

  .result__stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .result__stats dt {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text-muted);
  }

  .result__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.375rem, 5.5vw, 2rem);
    line-height: 1.1;
  }

  .result__channel,
  .result__actions {
    grid-column: 1 / -1;
  }

  .result__channel {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .result__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .results__note {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (min-width: 60rem) {
    .results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .result {
      padding: 1.25rem;
    }
  }
</style>
