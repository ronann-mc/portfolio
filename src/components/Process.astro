---
import { getDictionary, highlight, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id="process" class="section" aria-labelledby="process-title">
  <div class="container">
    <div class="section__head">
      <h2 id="process-title" class="display section-title" set:html={highlight(t.process.title)} />
      <p class="section__intro">{t.process.intro}</p>
    </div>
    <ol class="steps">
      {
        t.process.steps.map((step, index) => (
          <li class="step card">
            <span class="step__number" aria-hidden="true">
              {index + 1}
            </span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    padding: 1.25rem;
  }

  .step__number {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
  }

  .step__title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    align-self: center;
  }

  .step__text {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .step {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0.75rem;
    }

    .step__number {
      grid-row: auto;
    }
  }
</style>
