---
import { shared } from '../data/shared';
import { getDictionary, highlight, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const { email } = shared.site;
const mailto = `mailto:${email}?subject=${encodeURIComponent(t.contact.mailSubject)}`;
const hasForm = t.contact.formUrl !== '';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__card card">
      <h2 id="contact-title" class="display section-title" set:html={highlight(t.contact.title)} />
      <p class="contact__text">{t.contact.text}</p>
      <a class="btn btn--primary contact__cta" href={hasForm ? t.contact.formUrl : mailto}>
        {hasForm ? t.contact.ctaForm : t.contact.ctaMail}<span aria-hidden="true">→</span>
      </a>
      <p class="contact__mail">
        {hasForm && <span>{t.contact.orEmail} </span>}
        <a class="text-link" href={mailto}>{email}</a>
      </p>
      <p class="contact__time">{t.contact.responseTime}</p>
    </div>
  </div>
</section>

<style>
  .contact__card {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(1.75rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
    text-align: center;
    background:
      radial-gradient(40rem 20rem at 50% 0%, rgb(255 214 10 / 0.12), transparent 70%),
      var(--bg-raised);
  }

  .contact__text {
    max-width: 34rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 2.6vw, 1.125rem);
  }

  .contact__cta {
    min-height: 3.5rem;
    padding-inline: 2rem;
    font-size: 1.0625rem;
  }

  .contact__mail {
    overflow-wrap: anywhere;
  }

  .contact__time {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
